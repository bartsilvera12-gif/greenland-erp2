{
  "info": {
    "name": "Green Land · Web Service Cobranzas Bancard",
    "description": "Los 3 metodos del web service para Bancard / Infonet Cobranzas segun la especificacion 'API para Facturadores - Servicio de Cobranzas'.\n\nFormato de respuesta: { status, tid, messages, ... }.\n\nSetup:\n1. Editar variables del collection: base_url, sub_id, inv_id.\n2. El tid se genera con {{$timestamp}} para evitar choques entre corridas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://greenland.neura.com.py", "type": "string" },
    { "key": "prd_id", "value": "1", "type": "string" },
    { "key": "sub_id", "value": "1234567", "type": "string" },
    { "key": "inv_id", "value": "BNC-TEST-JUAN-C2", "type": "string" },
    { "key": "amt", "value": "1500000", "type": "string" },
    { "key": "tid", "value": "{{$timestamp}}", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Obtener Facturas (GET /deudas/consultar)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/bancard/deudas/consultar?tid={{tid}}&sub_id[]={{sub_id}}&prd_id={{prd_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "bancard", "deudas", "consultar"],
          "query": [
            { "key": "tid", "value": "{{tid}}" },
            { "key": "sub_id[]", "value": "{{sub_id}}" },
            { "key": "prd_id", "value": "{{prd_id}}" }
          ]
        },
        "description": "Devuelve la coleccion invoices con las cuotas pendientes del abonado. Si no tiene, devuelve messages[SubscriberWithoutDebt]."
      }
    },
    {
      "name": "2. Realizar un pago (POST /pagos)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tid\":     {{tid}},\n  \"prd_id\":  {{prd_id}},\n  \"sub_id\":  [\"{{sub_id}}\"],\n  \"inv_id\":  [\"{{inv_id}}\"],\n  \"amt\":     {{amt}},\n  \"curr\":    \"PYG\",\n  \"trn_dat\": \"20260629\",\n  \"trn_hou\": \"153000\",\n  \"cm_amt\":  0,\n  \"cm_curr\": \"PYG\",\n  \"addl\":    { \"payment_method\": \"CASH\" }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/bancard/pagos",
          "host": ["{{base_url}}"],
          "path": ["api", "bancard", "pagos"]
        }
      }
    },
    {
      "name": "2b. Reintentar mismo pago (idempotencia)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tid\":     {{tid}},\n  \"prd_id\":  {{prd_id}},\n  \"sub_id\":  [\"{{sub_id}}\"],\n  \"inv_id\":  [\"{{inv_id}}\"],\n  \"amt\":     {{amt}},\n  \"curr\":    \"PYG\",\n  \"trn_dat\": \"20260629\",\n  \"trn_hou\": \"153000\",\n  \"cm_amt\":  0,\n  \"cm_curr\": \"PYG\",\n  \"addl\":    { \"payment_method\": \"CASH\" }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/bancard/pagos",
          "host": ["{{base_url}}"],
          "path": ["api", "bancard", "pagos"]
        },
        "description": "Debe devolver PaymentProcessed con la aclaracion 'idempotente' en dsc."
      }
    },
    {
      "name": "3. Reversar Transaccion (POST /pagos/reversa)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"tid\": {{tid}} }"
        },
        "url": {
          "raw": "{{base_url}}/api/bancard/pagos/reversa",
          "host": ["{{base_url}}"],
          "path": ["api", "bancard", "pagos", "reversa"]
        }
      }
    },
    {
      "name": "4. Consulta post-reversa (debe volver a aparecer)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/api/bancard/deudas/consultar?tid={{tid}}&sub_id[]={{sub_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "bancard", "deudas", "consultar"],
          "query": [
            { "key": "tid", "value": "{{tid}}" },
            { "key": "sub_id[]", "value": "{{sub_id}}" }
          ]
        }
      }
    }
  ]
}
