{
  "info": {
    "name": "Green Land · Web Service Cobranzas Bancard",
    "description": "Los 3 metodos del web service para Bancard / Infonet Cobranzas.\n\nTodos los endpoints requieren X-Api-Key + X-Partner-Id.\n\nSetup:\n1. Editá las variables del collection (Variables tab): base_url, api_key, documento, numero_venta.\n2. El transaccion_id se genera con {{$timestamp}} para evitar choques entre corridas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://greenland.neura.com.py", "type": "string" },
    { "key": "api_key", "value": "CAMBIA_ESTO_POR_TU_KEY", "type": "string" },
    { "key": "partner_id", "value": "bancard", "type": "string" },
    { "key": "tipo_documento", "value": "ci", "type": "string" },
    { "key": "documento", "value": "1111111", "type": "string" },
    { "key": "numero_venta", "value": "BNC-TEST-001", "type": "string" },
    { "key": "monto", "value": "1500000", "type": "string" },
    { "key": "tx_id", "value": "TEST-{{$timestamp}}", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Consulta de deudas",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Api-Key", "value": "{{api_key}}" },
          { "key": "X-Partner-Id", "value": "{{partner_id}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_documento\": \"{{tipo_documento}}\",\n  \"documento\": \"{{documento}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/bancard/deudas/consultar",
          "host": ["{{base_url}}"],
          "path": ["api", "bancard", "deudas", "consultar"]
        }
      }
    },
    {
      "name": "2. Aplicar pago",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Api-Key", "value": "{{api_key}}" },
          { "key": "X-Partner-Id", "value": "{{partner_id}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transaccion_id\": \"{{tx_id}}\",\n  \"numero_venta\":   \"{{numero_venta}}\",\n  \"monto\":          {{monto}},\n  \"moneda\":         \"GS\",\n  \"metodo\":         \"transferencia\",\n  \"referencia\":     \"Pago boca Infonet\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/bancard/pagos",
          "host": ["{{base_url}}"],
          "path": ["api", "bancard", "pagos"]
        }
      }
    },
    {
      "name": "2b. Reintentar mismo pago (idempotencia)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Api-Key", "value": "{{api_key}}" },
          { "key": "X-Partner-Id", "value": "{{partner_id}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transaccion_id\": \"{{tx_id}}\",\n  \"numero_venta\":   \"{{numero_venta}}\",\n  \"monto\":          {{monto}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/bancard/pagos",
          "host": ["{{base_url}}"],
          "path": ["api", "bancard", "pagos"]
        },
        "description": "Debe devolver `ya_aplicado: true` con los mismos datos. Sin duplicar el cobro."
      }
    },
    {
      "name": "3. Reversar pago",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Api-Key", "value": "{{api_key}}" },
          { "key": "X-Partner-Id", "value": "{{partner_id}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transaccion_id\": \"{{tx_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/bancard/pagos/reversa",
          "host": ["{{base_url}}"],
          "path": ["api", "bancard", "pagos", "reversa"]
        }
      }
    },
    {
      "name": "4. Consulta post-reversa (debe volver a estar pendiente)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Api-Key", "value": "{{api_key}}" },
          { "key": "X-Partner-Id", "value": "{{partner_id}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_documento\": \"{{tipo_documento}}\",\n  \"documento\": \"{{documento}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/bancard/deudas/consultar",
          "host": ["{{base_url}}"],
          "path": ["api", "bancard", "deudas", "consultar"]
        }
      }
    }
  ]
}
